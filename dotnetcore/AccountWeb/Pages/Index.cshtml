@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <p class="text-uppercase text-secondary small mb-1">Signed in</p>
        <h1 class="h2 mb-0">@Model.AccountName</h1>
    </div>
    <form method="post" asp-page="/Logout">
        <button type="submit" class="btn btn-theme-outline">Logout</button>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-secondary-subtle h-100">
            <div class="card-body">
                <div class="text-secondary small">Level</div>
                <div class="fs-3 fw-semibold">@Model.Permission</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-secondary-subtle h-100">
            <div class="card-body">
                <div class="text-secondary small">Accounts</div>
                <div class="fs-3 fw-semibold">@Model.AccountsCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-secondary-subtle h-100">
            <div class="card-body">
                <div class="text-secondary small">Zones</div>
                <div class="fs-3 fw-semibold">@Model.ZonesCount</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-secondary-subtle mb-4">
    <div class="card-header">Search</div>
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-10">
                <label asp-for="Q" class="form-label">Account or alias</label>
                <input asp-for="Q" class="form-control" placeholder="Search by name or email" autocomplete="off" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Search</button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Q))
{
    <div class="card border-secondary-subtle mb-4">
        <div class="card-header d-flex justify-content-between gap-3">
            <span>Results</span>
            <span class="text-secondary">@Model.SearchResults.Count matches</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Type</th>
                        <th scope="col">Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Level</th>
                        <th scope="col">Owner</th>
                        <th scope="col">Last Access</th>
                        <th scope="col" class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.SearchResults.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-secondary">No accounts or aliases found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var result in Model.SearchResults)
                        {
                            <tr>
                                <td><span class="badge text-bg-secondary">@result.Type</span></td>
                                <td>@result.Name</td>
                                <td>@result.Email</td>
                                <td>@result.Level</td>
                                <td>@result.Owner</td>
                                <td>@result.LastAccess.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-theme-outline" href="@result.DetailsPath">Open</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card border-secondary-subtle">
    <div class="card-header">Account</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-secondary">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3 text-secondary">Last access</dt>
            <dd class="col-sm-9">@Model.LastAccess.ToString("yyyy-MM-dd HH:mm:ss")</dd>
        </dl>
    </div>
</div>
