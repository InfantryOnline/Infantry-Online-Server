@page "/reset-password"
@model AccountWeb.Pages.ResetPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Reset Password";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Infantry Online</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AccountWeb.styles.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    <main class="container">
        <div class="login-shell">
            <div class="card border-secondary-subtle login-card">
                <div class="card-body p-4">
                    @if (Model.Success)
                    {
                        <div class="mb-4">
                            <p class="text-uppercase text-secondary small mb-1">Infantry Online</p>
                            <h1 class="h3 mb-0">Password reset</h1>
                        </div>

                        <div class="alert alert-success" role="alert">
                            Your password has been reset. You can log into the game with the new password immediately.
                        </div>
                    }
                    else
                    {
                        <div class="mb-4">
                            <p class="text-uppercase text-secondary small mb-1">Infantry Online</p>
                            <h1 class="h3 mb-0">Reset password</h1>
                        </div>

                        <form method="post">
                            <input type="hidden" asp-for="Token" />
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="Input.Password" class="form-label"></label>
                                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" autofocus />
                                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Reset password</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
