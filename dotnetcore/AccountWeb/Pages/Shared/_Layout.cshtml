<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Infantry Online</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AccountWeb.styles.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    <header>
        <nav class="navbar navbar-expand-sm border-bottom border-secondary-subtle mb-4">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Infantry Online</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Histories/Index">Histories</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Zones/Index">Zones</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-theme-outline" id="themeToggle" aria-label="Toggle light mode">
                            Light
                        </button>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form method="post" asp-page="/Logout" class="d-flex">
                            <button type="submit" class="btn btn-sm btn-theme-outline">Logout</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top border-secondary-subtle footer text-secondary">
        <div class="container">
            &copy; 2026 - Infantry Online
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
